<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>preview</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\ReplayGlitchLogo.ico</ApplicationIcon>
    <AssemblyName>VaultLoop</AssemblyName>
    <RootNamespace>ReplayGlitchGTA</RootNamespace>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Deterministic>true</Deterministic>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    The build resolves net48 against the locally installed framework instead of the
    reference-assembly NuGet package, so it works without network access. Override
    FrameworkPathOverride on the command line only if the framework lives elsewhere.
  -->
  <PropertyGroup>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <FrameworkPathOverride Condition="'$(FrameworkPathOverride)' == ''">$(SystemRoot)\Microsoft.NET\Framework64\v4.0.30319</FrameworkPathOverride>
    <TimestampUrl Condition="'$(TimestampUrl)' == ''">https://timestamp.digicert.com</TimestampUrl>
    <PublishDirectory>$(MSBuildProjectDirectory)\publish</PublishDirectory>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\ReplayGlitchLogo.png" LogicalName="ReplayGlitchLogo.png" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

  <Target Name="ValidateFrameworkPath" BeforeTargets="BeforeBuild">
    <Error Condition="!Exists('$(FrameworkPathOverride)\mscorlib.dll')"
           Text=".NET Framework 4.x assemblies were not found at $(FrameworkPathOverride)." />
  </Target>

  <!--
    Guards the elevation, DPI, and OS-compatibility declarations the app depends on.
    Set SkipManifestValidation=true only for a throwaway non-elevated test build.
  -->
  <Target Name="ValidateManifest" BeforeTargets="BeforeBuild"
          Condition="'$(SkipManifestValidation)' != 'true'">
    <PropertyGroup>
      <ManifestPath>$([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(ApplicationManifest)'))</ManifestPath>
      <ManifestText>$([System.IO.File]::ReadAllText('$(ManifestPath)'))</ManifestText>
    </PropertyGroup>
    <Error Condition="!$(ManifestText.Contains('requireAdministrator'))"
           Text="app.manifest must request firewall elevation (requireAdministrator)." />
    <Error Condition="!$(ManifestText.Contains('PerMonitorV2'))"
           Text="app.manifest must declare PerMonitorV2 DPI awareness." />
    <Error Condition="!$(ManifestText.Contains('longPathAware'))"
           Text="app.manifest must declare longPathAware." />
    <Error Condition="!$(ManifestText.Contains('{8e0f7a12-bfb3-4fe8-b9a5-48fd50a15a9a}'))"
           Text="app.manifest must declare Windows 10/11 compatibility." />
  </Target>

  <!-- A release build must stay a single self-contained executable. -->
  <Target Name="ValidateSingleFileOutput" AfterTargets="Build"
          Condition="'$(Configuration)' == 'Release'">
    <ItemGroup>
      <UnexpectedOutputFile Include="$(OutDir)**\*" Exclude="$(OutDir)$(TargetFileName)" />
    </ItemGroup>
    <Error Condition="'@(UnexpectedOutputFile)' != ''"
           Text="The release build produced unexpected files: @(UnexpectedOutputFile->'%(Filename)%(Extension)', ', ')" />
  </Target>

  <!--
    Copies the validated release binary to publish\ and optionally signs it:
      dotnet build -c Release -t:Ship
      dotnet build -c Release -t:Ship -p:CertificateThumbprint=<40 hex chars>
  -->
  <Target Name="Ship" DependsOnTargets="Build">
    <Error Condition="'$(Configuration)' != 'Release'"
           Text="Ship requires -c Release; a Debug build exposes --selftest and --render-preview." />
    <MakeDir Directories="$(PublishDirectory)" />
    <Copy SourceFiles="$(TargetPath)"
          DestinationFiles="$(PublishDirectory)\$(TargetFileName)" />
    <Exec Condition="'$(CertificateThumbprint)' != ''"
          Command="signtool sign /fd sha256 /sha1 $(CertificateThumbprint) /tr $(TimestampUrl) /td sha256 &quot;$(PublishDirectory)\$(TargetFileName)&quot;" />
    <Message Importance="high"
             Text="Shipped $(PublishDirectory)\$(TargetFileName)" />
  </Target>
</Project>
